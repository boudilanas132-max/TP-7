<?xml version="1.0" encoding="UTF-8"?>

<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3
        http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <!-- Cache des entités Auteur -->
    <cache alias="com.example.model.Auteur">
        <key-type>java.lang.Long</key-type>
        <value-type>com.example.model.Auteur</value-type>
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <heap unit="entries">1000</heap>
    </cache>

    <!-- Cache des entités Livre -->
    <cache alias="com.example.model.Livre">
        <key-type>java.lang.Long</key-type>
        <value-type>com.example.model.Livre</value-type>
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <heap unit="entries">1000</heap>
    </cache>

</config>
